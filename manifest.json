{
  "manifest_version": 3,
  "name": "join-active-tab-group",
  "version": "1.8.0",
  "description": "New tabs join the expanded tab group or a named group based on URL rules. Expanding a group collapses the others.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open URL rules"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
